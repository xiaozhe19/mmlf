# Gradle / 构建产物
.gradle/
**/build/
**/bin/
.cache/

# Minecraft 开发运行目录与 MMLF 会话
**/run/
runtime/

# 文档与报告不入库（README 引用的图片除外）
docs/*
!docs/media/

# AI 助手配置与说明（不参与构建）
AGENTS.md
CLAUDE.md
.claude/

# 日志、崩溃与临时输出
*.log
logs/
crash-reports/
*.hprof
out/
*.tmp

# IDE（ModDevGradle 生成的 launch.json 含本机绝对路径）
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# 系统文件
.DS_Store
Thumbs.db

# 第三方 Mod 由 scripts/fetch-demo-mods.ps1 按 manifest 下载校验，不入库
mmlf/mods/*.jar
