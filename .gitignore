# Gradle / 构建产物
.gradle/
**/build/
**/bin/
.cache/

# Minecraft 开发运行目录与 MMLF 会话
**/run/
# 只忽略会话输出目录，不忽略同名的源码包（launcher/.../runtime）
/runtime/
/coordinator/runtime/

# 文档与报告不入库（README 引用的图片除外）
docs/*
!docs/media/

# AI 助手配置与说明（不参与构建）
AGENTS.md
CLAUDE.md
.claude/

# 日志、崩溃与临时输出
*.log
logs/
crash-reports/
*.hprof
out/
*.tmp

# IDE（ModDevGradle 生成的 launch.json 含本机绝对路径）
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# 系统文件
.DS_Store
Thumbs.db

# 第三方 Mod 由 scripts/fetch-demo-mods.ps1 按 manifest 下载校验，不入库
mmlf/mods/*.jar

# 兼容性测试 Mod 由 scripts/compat 解析、下载、校验，不入库
mmlf/compat/jars/
mmlf/compat/stage/
mmlf/compat/results/

# 本地代码索引、运行时提取的原生库与截图
/.codegraph/
/natives-far/
/natives-near/
/c80ac039-b139-4817-8966-647fb5d7c743.png

# Python 缓存
__pycache__/
*.py[cod]

# 脚本不加入最小源码包；已跟踪的文件需另行从索引移除
/scripts/
